node_modules
dist
dist-ssr
*.local

# Env — real credentials never get committed; the template does.
# Keep the negation last: a later broader pattern (e.g. .env*) would
# silently re-ignore .env.example, since the last matching rule wins.
.env
.env.*
!.env.example

