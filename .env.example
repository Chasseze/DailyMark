# Copy this file to .env.local and fill both values in, then restart `npm run dev`
# (Vite only reads env files at startup).
#
# Both come from your Supabase dashboard: Project Settings -> API.
# The anon key is a publishable client key, safe to ship in the browser bundle —
# row-level security is what protects the data. Never put the service_role key
# here; it bypasses RLS entirely and must stay server-side.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRla3pqdXVlcmJvemV2bXpueW1kIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUxMjkzODYsImV4cCI6MjEwMDcwNTM4Nn0.uFRVT_dKT-A7k_G9PwWS2F89qxrziDHf_KOpJVq44ro
